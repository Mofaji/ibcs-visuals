model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","Calendar","Account","BSAccount","CFLine","BusinessUnit","Region","Product","SalesChannel","Department","FactPL","FactBS","FactCF","FactHeadcount","ViewSelector","ComparisonSelector"]

ref table Calendar
ref table Account
ref table BSAccount
ref table CFLine
ref table BusinessUnit
ref table Region
ref table Product
ref table SalesChannel
ref table Department
ref table FactPL
ref table FactBS
ref table FactCF
ref table FactHeadcount
ref table ViewSelector
ref table ComparisonSelector
ref table _Measures
ref table _SVG_Measures

ref expression DataFolder
ref cultureInfo en-US

