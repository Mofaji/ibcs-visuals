/// Month-end full-time equivalents by business unit, region and department.
table FactHeadcount
	lineageTag: c88a2a08-bfcc-5326-a770-fa907b14a632

	column Date
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: dcef5b50-11f7-5133-be0a-b4c87ca08df1
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column BUKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 973bdc0c-826b-54fa-b442-f0d2ba880ae0
		summarizeBy: none
		sourceColumn: BUKey

	column RegionKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: feeb8a85-e30b-56b3-8c01-62b1b6e6a6d1
		summarizeBy: none
		sourceColumn: RegionKey

	column DepartmentKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d01a35e2-9e28-5016-b23b-7df42b6617fa
		summarizeBy: none
		sourceColumn: DepartmentKey

	column Scenario
		dataType: string
		lineageTag: 2b57b869-3a85-5c7d-9bb3-b70880594871
		summarizeBy: none
		sourceColumn: Scenario

	column FTE
		dataType: double
		isHidden
		formatString: #,0.0
		lineageTag: f1742abc-acc7-5e73-b500-d3178b8cd079
		summarizeBy: none
		sourceColumn: FTE

	partition FactHeadcount = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactHeadcount.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"BUKey", Int64.Type}, {"RegionKey", Int64.Type}, {"DepartmentKey", Int64.Type}, {"Scenario", type text}, {"FTE", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table

