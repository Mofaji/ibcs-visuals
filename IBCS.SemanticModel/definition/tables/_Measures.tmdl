		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 143c4012-50ce-5794-b54c-4a41aa77928e

	/// Total Assets at the end of the as-of month, comparison.
	measure 'Total Assets PM' = CALCULATE([Balance PM], KEEPFILTERS('BSAccount'[BS Level 1] = "Assets"))
