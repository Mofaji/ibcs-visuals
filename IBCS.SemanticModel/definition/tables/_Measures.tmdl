		lineageTag: 174875de-3b2f-5cff-bc31-b8f13c4c0f19

	/// Inventory at the end of the as-of month, actual.
	measure 'Inventory AC' = CALCULATE([Balance AC], KEEPFILTERS('BSAccount'[BS Metric] = "INV"))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 1a5cbaff-2ffb-5b42-99cb-b85e6323447b

	/// Inventory at the end of the as-of month, comparison.
	measure 'Inventory PM' = CALCULATE([Balance PM], KEEPFILTERS('BSAccount'[BS Metric] = "INV"))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 04d0606b-516c-50e2-ade5-c87d4996daf8

	/// Payables at the end of the as-of month, actual.
	measure 'Payables AC' = CALCULATE([Balance AC], KEEPFILTERS('BSAccount'[BS Metric] = "AP"))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: a629f746-67f0-597c-b16e-036ba22abef8

