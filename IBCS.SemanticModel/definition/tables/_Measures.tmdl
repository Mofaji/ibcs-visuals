/// Business measures. AC/PM follow the View and Compare toggles.
table _Measures
	lineageTag: c2b2e538-9205-54b0-850c-34ad7bf9a297

	/// Last day of the last month whose actuals are closed.
	measure 'Last Closed Date' = CALCULATE(MAX('Calendar'[Date]), REMOVEFILTERS('Calendar'), 'Calendar'[Period Status] = "Closed")
		formatString: dd mmm yyyy
		displayFolder: Context
		lineageTag: 9724cca6-9468-5bf7-8c40-bcb13983f877

	/// End of the reporting window: the latest date in the Year/Month selection, capped at the last closed month.
	measure 'As Of Date' =
			VAR _max = MAX('Calendar'[Date])
			VAR _last = [Last Closed Date]
			RETURN IF(ISBLANK(_max), _last, MIN(_max, _last))
		formatString: dd mmm yyyy
		displayFolder: Context
		lineageTag: e4d3c4e7-40f6-596a-ab15-11cbce7e4c3f

	/// Reporting window chosen with the View toggle: YTD, QTD or MTD (default YTD).
	measure 'Selected View' = SELECTEDVALUE('ViewSelector'[View], "YTD")
		displayFolder: Context
		lineageTag: 5e4a0273-1103-5ed8-bbb3-e092adcd8a70

	/// Comparison scenario chosen with the Compare toggle: Budget, Prior Year or Forecast (default Budget).
	measure 'Selected Comparison' = SELECTEDVALUE('ComparisonSelector'[Comparison], "Budget")
		displayFolder: Context
		lineageTag: 5e11dbe5-7b06-5c7d-af21-895346a476cb

	/// IBCS scenario code of the comparison (BU, PY, FC); feeds the column headers of the IBCS visuals.
	measure 'Comparison Code' = SWITCH([Selected Comparison], "Prior Year", "PY", "Forecast", "FC", "BU")
		displayFolder: Context
		lineageTag: ee81b514-2dad-5e02-be0d-4f5006d9eafa

	/// Comparison as text, e.g. 'vs Budget'.
	measure 'Comparison Label' = "vs " & [Selected Comparison]
		displayFolder: Context
		lineageTag: b3a5efe2-b14b-5137-bb65-9e8e40e84ead

	/// First day of the reporting window for the selected View.
	measure 'Period Start' =
			VAR _asof = [As Of Date]
			RETURN
			    SWITCH([Selected View],
			        "MTD", DATE(YEAR(_asof), MONTH(_asof), 1),
			        "QTD", DATE(YEAR(_asof), (ROUNDUP(MONTH(_asof) / 3, 0) - 1) * 3 + 1, 1),
			        DATE(YEAR(_asof), 1, 1))
		formatString: dd mmm yyyy
		displayFolder: Context
		lineageTag: 949d198c-c131-5343-8218-20a73b6418c7

	/// Number of months in the reporting window.
	measure 'Months In Period' = DATEDIFF([Period Start], [As Of Date], MONTH) + 1
		formatString: 0
		displayFolder: Context
		lineageTag: 36159443-3b9a-54fc-9f04-db84a533b0ab

	/// Reporting window as text, e.g. 'YTD Sep 2026'.
	measure 'Period Label' = [Selected View] & " " & FORMAT([As Of Date], "mmm yyyy")
		displayFolder: Context
		lineageTag: e6371fe0-f89d-538f-8bc9-7e0e914ef038

	/// Actual P&L amount in the current filter context, no time window. Revenue positive, costs negative.
	measure 'Actual Amount' = CALCULATE(SUM(FactPL[Amount]), FactPL[Scenario] = "Actual")
		formatString: #,0
		displayFolder: P&L\Base
		lineageTag: 53b8727a-33f7-5e69-809c-e2eafa97bcb5

	/// Budget P&L amount in the current filter context, no time window. Revenue positive, costs negative.
	measure 'Budget Amount' = CALCULATE(SUM(FactPL[Amount]), FactPL[Scenario] = "Budget")
		formatString: #,0
		displayFolder: P&L\Base
		lineageTag: 92cb95f1-004d-5de7-b80f-cb0a8cdc3820

	/// Forecast P&L amount in the current filter context, no time window. Revenue positive, costs negative.
	measure 'Forecast Amount' = CALCULATE(SUM(FactPL[Amount]), FactPL[Scenario] = "Forecast")
		formatString: #,0
		displayFolder: P&L\Base
		lineageTag: e4cfc6e7-2dfa-5c62-bc42-8be5847cdfdc

	/// Actual P&L amount for the same period one year earlier.
	measure 'Prior Year Amount' = CALCULATE([Actual Amount], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0
		displayFolder: P&L\Base
		lineageTag: 045cd441-d200-5b06-95db-41db4f9cc06d

	/// P&L amount of the comparison scenario chosen with the Compare toggle, no time window. For monthly charts.
	measure 'Comparison Amount' = SWITCH([Selected Comparison], "Prior Year", [Prior Year Amount], "Forecast", [Forecast Amount], [Budget Amount])
		formatString: #,0
		displayFolder: P&L\Base
		lineageTag: 2bb7cd95-5ce7-54a3-844c-1f4d8f2f6280

	/// Actual P&L amount for the reporting window (View toggle, ending at the as-of month).
	measure 'Amount AC' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: P&L
		lineageTag: a832041c-7129-5488-826c-843f5352849b

	/// Budget for the reporting window.
	measure 'Amount BU' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Budget Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: P&L
		lineageTag: 44c2a6c2-9466-57af-b9f5-d4b8fad5a310

	/// 6+6 forecast for the reporting window (Jan-Jun actual, Jul-Dec forecast).
	measure 'Amount FC' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Forecast Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: P&L
		lineageTag: 22b0fc41-3326-55bc-b6c3-26cda466057f

	/// Actual for the same window one year earlier.
	measure 'Amount PY' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= EDATE(_start, -12) && 'Calendar'[Date] <= EDATE(_end, -12)))
		formatString: #,0
		displayFolder: P&L
		lineageTag: adb107ce-55df-5f84-a41f-4c19ae9c3980

	/// Actual for the same window two years earlier (prior-year growth).
	measure 'Amount PY2' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= EDATE(_start, -24) && 'Calendar'[Date] <= EDATE(_end, -24)))
		formatString: #,0
		displayFolder: P&L
		lineageTag: ebbade32-d698-59cb-bfbe-ddf4641139cc

	/// Comparison amount for the reporting window, following the Compare toggle.
	measure 'Amount PM' = SWITCH([Selected Comparison], "Prior Year", [Amount PY], "Forecast", [Amount FC], [Amount BU])
		formatString: #,0
		displayFolder: P&L
		lineageTag: 0b07c9b0-1170-5c04-9be2-2880b70f9f45

	/// Actual minus comparison for the reporting window. Positive is favourable because costs are negative.
	measure 'Amount Variance' = IF(ISBLANK([Amount AC]) || ISBLANK([Amount PM]), BLANK(), [Amount AC] - [Amount PM])
		formatString: #,0
		displayFolder: P&L
		lineageTag: 2c778012-af21-55d9-a32f-fbe1b44a2765

	/// Relative variance of actual against the comparison.
	measure 'Amount Variance %' = DIVIDE([Amount AC] - [Amount PM], ABS([Amount PM]))
		formatString: 0.0%
		displayFolder: P&L
		lineageTag: ab3ebd37-afe5-53fa-80f7-fcb4febca049

	/// Net Revenue, actual value for the reporting window (signed: costs negative).
	measure 'Net Revenue AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 8b5e13bf-065a-5f4c-be3b-eee11dd17fea

	/// Net Revenue, comparison value for the reporting window (signed: costs negative).
	measure 'Net Revenue PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 4506e6a1-4629-5b69-9de2-f4963e4cfd76

	/// Net Revenue, prior-year value for the reporting window (signed: costs negative).
	measure 'Net Revenue PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e1036546-2dfa-5b75-93b4-12a1dd8b5004

	/// Net Revenue, budget value for the reporting window (signed: costs negative).
	measure 'Net Revenue BU' = CALCULATE([Amount BU], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 00c049f1-c562-5838-859e-5fb2e0dd97ea

	/// Net Revenue, forecast value for the reporting window (signed: costs negative).
	measure 'Net Revenue FC' = CALCULATE([Amount FC], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 136deee2-6efe-505b-bc6d-c36096847dd6

	/// Net Revenue, two-years-earlier value for the reporting window (signed: costs negative).
	measure 'Net Revenue PY2' = CALCULATE([Amount PY2], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: bb49c7db-3f82-5e8e-a59a-3934ae47dac8

	/// Net Revenue, actual value in the current month context (for month-axis charts).
	measure 'Net Revenue Monthly AC' = CALCULATE([Actual Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: 62a9a8f7-280b-5655-abbf-58cb941d10b9

	/// Net Revenue, comparison value in the current month context (for month-axis charts).
	measure 'Net Revenue Monthly PM' = CALCULATE([Comparison Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: f20553f4-9a20-53f2-995b-7a5eedddb516

	/// Cost of Sales, actual value for the reporting window (signed: costs negative).
	measure 'Cost of Sales AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 8665eea4-07a5-5044-acdc-446b854c0866

	/// Cost of Sales, comparison value for the reporting window (signed: costs negative).
	measure 'Cost of Sales PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 08dad8e6-ce5b-58ac-8052-3fd2576a03d8

	/// Cost of Sales, prior-year value for the reporting window (signed: costs negative).
	measure 'Cost of Sales PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: b35d34ca-e0bc-59f4-9758-def643ec5407

	/// Gross Profit, actual value for the reporting window (signed: costs negative).
	measure 'Gross Profit AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 6c985981-555a-5fe6-b545-27b71336cd66

	/// Gross Profit, comparison value for the reporting window (signed: costs negative).
	measure 'Gross Profit PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: cc4ac4e4-0812-5ab2-9efe-bc00028cd69d

	/// Gross Profit, prior-year value for the reporting window (signed: costs negative).
	measure 'Gross Profit PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 8a588c2a-f3e6-513a-b739-e03510268589

	/// Gross Profit, actual value in the current month context (for month-axis charts).
	measure 'Gross Profit Monthly AC' = CALCULATE([Actual Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: dcde1f7f-ec72-5b1f-ba7a-e8fdd092abd3

	/// Gross Profit, comparison value in the current month context (for month-axis charts).
	measure 'Gross Profit Monthly PM' = CALCULATE([Comparison Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: 8724d84b-55c4-55fa-aa12-f9b5bce623b0

	/// Operating Expenses, actual value for the reporting window (signed: costs negative).
	measure 'Operating Expenses AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: bf0e7d7e-a39c-533c-b0e2-e2544c547ae5

	/// Operating Expenses, comparison value for the reporting window (signed: costs negative).
	measure 'Operating Expenses PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: fd024c80-477d-5e02-96e4-aeb6b0a0027e

	/// Operating Expenses, prior-year value for the reporting window (signed: costs negative).
	measure 'Operating Expenses PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: c70c1317-f9a7-510d-9105-748df3440502

	/// EBITDA, actual value for the reporting window (signed: costs negative).
	measure 'EBITDA AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 9b01d9ff-f68b-560f-a296-eaa826421380

	/// EBITDA, comparison value for the reporting window (signed: costs negative).
	measure 'EBITDA PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e0e0779c-5121-57fc-8cf9-d7e5e519d421

	/// EBITDA, prior-year value for the reporting window (signed: costs negative).
	measure 'EBITDA PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 24205f67-935c-50af-9e25-6dceb53dc6e6

	/// EBITDA, actual value in the current month context (for month-axis charts).
	measure 'EBITDA Monthly AC' = CALCULATE([Actual Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: 83576f7a-2d5a-5639-b589-9a3d385a8e2f

	/// EBITDA, comparison value in the current month context (for month-axis charts).
	measure 'EBITDA Monthly PM' = CALCULATE([Comparison Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: aa0d6564-50b3-5a2f-9bab-433a4428de09

	/// D&A, actual value for the reporting window (signed: costs negative).
	measure 'D&A AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 33324f61-3c52-57b6-848e-65bbd3be334e

	/// D&A, comparison value for the reporting window (signed: costs negative).
	measure 'D&A PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 3524d6c3-8d20-59a4-b7f4-5d861c2b3015

	/// D&A, prior-year value for the reporting window (signed: costs negative).
	measure 'D&A PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e12c553b-b1a1-53bf-a192-8f265aa6ed91

	/// EBIT, actual value for the reporting window (signed: costs negative).
	measure 'EBIT AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 77aa7148-5942-55b8-8f8b-43f6c923ede3

	/// EBIT, comparison value for the reporting window (signed: costs negative).
	measure 'EBIT PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 6b2b0103-0067-5dee-816d-2db4504c7321

	/// EBIT, prior-year value for the reporting window (signed: costs negative).
	measure 'EBIT PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e831d844-40e0-5687-9b57-274c44422171

	/// Financial Result, actual value for the reporting window (signed: costs negative).
	measure 'Financial Result AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: ed768ba9-f745-5250-89ed-6460a5c300fc

	/// Financial Result, comparison value for the reporting window (signed: costs negative).
	measure 'Financial Result PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: b61d5fc3-ba52-589c-a9be-77efc6b09112

	/// Financial Result, prior-year value for the reporting window (signed: costs negative).
	measure 'Financial Result PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e440bd35-ac85-5a13-9975-6a0a32dc319b

	/// Profit Before Tax, actual value for the reporting window (signed: costs negative).
	measure 'Profit Before Tax AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: b16b8cb1-85c5-52db-bb61-2e8bd73878c3

	/// Profit Before Tax, comparison value for the reporting window (signed: costs negative).
	measure 'Profit Before Tax PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: efeeac6e-45ed-56e8-a25b-6553fbe48148

	/// Profit Before Tax, prior-year value for the reporting window (signed: costs negative).
	measure 'Profit Before Tax PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 75fbac9f-015e-5cbe-aff9-1c14294523e8

	/// Income Tax, actual value for the reporting window (signed: costs negative).
	measure 'Income Tax AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: e7a8d845-e409-5b3d-aa52-6a401d7ac399

	/// Income Tax, comparison value for the reporting window (signed: costs negative).
	measure 'Income Tax PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 206d409c-1ad1-53e7-aedb-f8310319210a

	/// Income Tax, prior-year value for the reporting window (signed: costs negative).
	measure 'Income Tax PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 991eedec-6a21-5931-93a2-9676e657d4de

	/// Net Income, actual value for the reporting window (signed: costs negative).
	measure 'Net Income AC' = CALCULATE([Amount AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result", "Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: c8fdad65-059f-504e-ae38-e443e7d2c174

	/// Net Income, comparison value for the reporting window (signed: costs negative).
	measure 'Net Income PM' = CALCULATE([Amount PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result", "Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: b12dd64e-14c5-5120-b4c8-232831fe2763

	/// Net Income, prior-year value for the reporting window (signed: costs negative).
	measure 'Net Income PY' = CALCULATE([Amount PY], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result", "Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Lines
		lineageTag: 46305ee4-07f3-5941-b705-a32d5ea576fc

	/// Net Income, actual value in the current month context (for month-axis charts).
	measure 'Net Income Monthly AC' = CALCULATE([Actual Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result", "Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: 623e017c-1582-5f88-ad55-59534e3c77c9

	/// Net Income, comparison value in the current month context (for month-axis charts).
	measure 'Net Income Monthly PM' = CALCULATE([Comparison Amount], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization", "Financial Result", "Income Tax"}))
		formatString: #,0
		displayFolder: P&L\Monthly
		lineageTag: b2653c84-1403-5fb0-84d4-3ff243ca0b07

	/// Gross Profit as a share of net revenue, actual.
	measure 'Gross Margin % AC' = DIVIDE([Gross Profit AC], [Net Revenue AC])
		formatString: 0.0%
		displayFolder: P&L\Margins
		lineageTag: 58ce5dee-c87e-5158-abb0-65cc65517a85

	/// Gross Profit as a share of net revenue, comparison.
