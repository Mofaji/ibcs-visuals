	/// Discounts and returns as a share of gross revenue, comparison.
	measure 'Discount Rate % PM' = DIVIDE([Discounts PM], [Net Revenue PM] + [Discounts PM])
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: 1ad04cc9-d138-551f-af18-91e24eef2460

	/// Actual net revenue growth against the same window one year earlier.
	measure 'Revenue Growth % AC' = DIVIDE([Net Revenue AC] - [Net Revenue PY], ABS([Net Revenue PY]))
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: ee1cac6d-864b-5da0-b166-cc0d31a4acb6

	/// Growth implied by the comparison scenario (budget or forecast growth, or last year's growth).
	measure 'Revenue Growth % PM' =
			VAR _py = [Net Revenue PY]
			RETURN
			    SWITCH([Selected Comparison], "Prior Year", DIVIDE(_py - [Net Revenue PY2], ABS([Net Revenue PY2])), "Forecast", DIVIDE([Net Revenue FC] - _py, ABS(_py)), DIVIDE([Net Revenue BU] - _py, ABS(_py)))
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: c5022e90-7c78-54f4-9b6a-87a9811a26c9

	/// Actual net revenue in USD thousands, for native visuals labelled 'USD K'.
	measure 'Net Revenue (USD K)' = DIVIDE([Net Revenue AC], 1000)
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 171fc60c-49b1-5d90-8b0e-8086dbae4d54

	/// Actual full-time equivalents at the end of the as-of month.
	measure 'FTE AC' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN CALCULATE(SUM(FactHeadcount[FTE]), FactHeadcount[Scenario] = "Actual", FILTER(ALL('Calendar'), 'Calendar'[Date] = _m))
		formatString: #,0
		displayFolder: Expenses
		lineageTag: 430755ff-9d7c-572e-a7ac-4f90f73e89b4

	/// Comparison FTE: prior year same month, else budget (no forecast headcount is planned).
	measure 'FTE PM' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN
			    IF([Selected Comparison] = "Prior Year",
			        CALCULATE(SUM(FactHeadcount[FTE]), FactHeadcount[Scenario] = "Actual", FILTER(ALL('Calendar'), 'Calendar'[Date] = EDATE(_m, -12))),
			        CALCULATE(SUM(FactHeadcount[FTE]), FactHeadcount[Scenario] = "Budget", FILTER(ALL('Calendar'), 'Calendar'[Date] = _m)))
		formatString: #,0
		displayFolder: Expenses
		lineageTag: b6efa34d-0fb9-5be2-b053-6c456303a1ab

	/// Monthly personnel cost per full-time equivalent, actual.
	measure 'Cost per FTE AC' = DIVIDE([Personnel Cost AC], [FTE AC] * [Months In Period])
		formatString: #,0
		displayFolder: Expenses
		lineageTag: 198cbcdd-3914-5a72-a561-bf036214d4e4

	/// Monthly personnel cost per full-time equivalent, comparison.
	measure 'Cost per FTE PM' = DIVIDE([Personnel Cost PM], [FTE PM] * [Months In Period])
		formatString: #,0
		displayFolder: Expenses
		lineageTag: 9dc84771-c12b-5723-b5c5-1bdc85ce770e

	/// Actual balance at the end of the as-of month.
	measure 'Balance AC' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Actual", FILTER(ALL('Calendar'), 'Calendar'[Date] = _m))
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 8ca10e3a-5812-5810-a583-bda119df4dae

	/// Budget balance at the end of the as-of month.
	measure 'Balance BU' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Budget", FILTER(ALL('Calendar'), 'Calendar'[Date] = _m))
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 813879f5-acc5-5a36-803b-c2431c38f7ad

	/// Forecast balance at the end of the as-of month.
	measure 'Balance FC' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Forecast", FILTER(ALL('Calendar'), 'Calendar'[Date] = _m))
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 73990c7b-c008-5f1a-89cc-f50901b38ff2

	/// Actual balance at the end of the same month one year earlier.
	measure 'Balance PY' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			RETURN CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Actual", FILTER(ALL('Calendar'), 'Calendar'[Date] = EDATE(_m, -12)))
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 24120101-d9f7-529c-968d-5ca5707837cf

	/// Comparison balance at the as-of month, following the Compare toggle.
	measure 'Balance PM' = SWITCH([Selected Comparison], "Prior Year", [Balance PY], "Forecast", [Balance FC], [Balance BU])
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 5113811a-1406-5fff-b84f-f91083f8c62c

	/// Actual month-end balance in the current month context (for month-axis charts only).
	measure 'Balance Monthly AC' = CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Actual")
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
		lineageTag: 7c1dbf2c-1da1-57a9-b309-871c38da8dd1

	/// Comparison month-end balance in the current month context.
	measure 'Balance Monthly PM' = SWITCH([Selected Comparison], "Prior Year", CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Actual", SAMEPERIODLASTYEAR('Calendar'[Date])), "Forecast", CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Forecast"), CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = "Budget"))
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
