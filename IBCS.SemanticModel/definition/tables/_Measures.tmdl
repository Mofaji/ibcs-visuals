	measure 'Payables PM' = CALCULATE([Balance PM], KEEPFILTERS('BSAccount'[BS Metric] = "AP"))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 651f437f-ecf4-591c-b891-91c753db2d07

	/// Total Debt at the end of the as-of month, actual.
	measure 'Total Debt AC' = CALCULATE([Balance AC], KEEPFILTERS('BSAccount'[BS Metric] IN {"STD", "LTD"}))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 1b9f2b9a-6267-5147-8a85-871fcc10721f

	/// Total Debt at the end of the as-of month, comparison.
	measure 'Total Debt PM' = CALCULATE([Balance PM], KEEPFILTERS('BSAccount'[BS Metric] IN {"STD", "LTD"}))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: 49babd13-e825-5255-9dad-60a8468524bd

	/// Cash balance in the current month context, actual.
	measure 'Cash Monthly AC' = CALCULATE([Balance Monthly AC], KEEPFILTERS('BSAccount'[BS Metric] = "CASH"))
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
		lineageTag: 00f3b34a-cd51-50a2-9d78-10819e0e3b86

	/// Net working capital in the current month context, actual.
	measure 'Working Capital Monthly AC' = CALCULATE([Balance Monthly AC], KEEPFILTERS('BSAccount'[BS Level 2] = "Current Assets")) - CALCULATE([Balance Monthly AC], KEEPFILTERS('BSAccount'[BS Level 2] = "Current Liabilities"))
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
		lineageTag: 589ecad4-4c07-5a21-811e-13bc9eeb3c8d

	/// Current assets minus current liabilities, actual.
	measure 'Working Capital AC' = [Current Assets AC] - [Current Liabilities AC]
		formatString: #,0
		displayFolder: Balance Sheet\Ratios
		lineageTag: 0d13b4e8-a004-511f-8ecb-b2addb4304a1

	/// Short- and long-term debt less cash, actual. Negative means net cash.
	measure 'Net Debt AC' = [Total Debt AC] - [Cash AC]
		formatString: #,0
		displayFolder: Balance Sheet\Ratios
		lineageTag: b96ce5a9-9bac-5807-83a9-53f6aa4771be

	/// Current assets over current liabilities, actual.
	measure 'Current Ratio AC' = DIVIDE([Current Assets AC], [Current Liabilities AC])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: efb7215f-09e9-5fbd-80bd-0bd56babbd0a

	/// Cash plus receivables over current liabilities, actual.
	measure 'Quick Ratio AC' = DIVIDE([Cash AC] + [Receivables AC], [Current Liabilities AC])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: 7eafb0f4-a826-560e-a09f-759f6dac65fa

	/// Total debt over equity, actual.
	measure 'Debt to Equity AC' = DIVIDE([Total Debt AC], [Total Equity AC])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: f13f9c84-fd5a-5ee6-9375-e08874548d0b

	/// Equity as a share of total assets, actual.
	measure 'Equity Ratio AC' = DIVIDE([Total Equity AC], [Total Assets AC])
		formatString: 0.0%
		displayFolder: Balance Sheet\Ratios
		lineageTag: 9fa61d28-cf31-5052-8b72-359d455a4453

	/// Cash balance in the current month context, comparison.
	measure 'Cash Monthly PM' = CALCULATE([Balance Monthly PM], KEEPFILTERS('BSAccount'[BS Metric] = "CASH"))
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
		lineageTag: 6708adf4-b3c3-53c8-b5bd-9b283eec27a6

	/// Net working capital in the current month context, comparison.
	measure 'Working Capital Monthly PM' = CALCULATE([Balance Monthly PM], KEEPFILTERS('BSAccount'[BS Level 2] = "Current Assets")) - CALCULATE([Balance Monthly PM], KEEPFILTERS('BSAccount'[BS Level 2] = "Current Liabilities"))
		formatString: #,0
		displayFolder: Balance Sheet\Monthly
		lineageTag: af319946-3234-5960-a93e-8d010eb39ddd

	/// Current assets minus current liabilities, comparison.
	measure 'Working Capital PM' = [Current Assets PM] - [Current Liabilities PM]
		formatString: #,0
		displayFolder: Balance Sheet\Ratios
		lineageTag: 1f414763-1783-558f-b621-6dc7ddb96c3d

	/// Short- and long-term debt less cash, comparison. Negative means net cash.
	measure 'Net Debt PM' = [Total Debt PM] - [Cash PM]
		formatString: #,0
		displayFolder: Balance Sheet\Ratios
		lineageTag: f6d3cfde-8663-55c1-86ba-5fd1dcf70b55

	/// Current assets over current liabilities, comparison.
	measure 'Current Ratio PM' = DIVIDE([Current Assets PM], [Current Liabilities PM])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: f109b7fd-f98d-577c-8112-68129918f14a

	/// Cash plus receivables over current liabilities, comparison.
	measure 'Quick Ratio PM' = DIVIDE([Cash PM] + [Receivables PM], [Current Liabilities PM])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: 8a59f2d0-d368-5d68-a95e-67d598f83d5c

	/// Total debt over equity, comparison.
	measure 'Debt to Equity PM' = DIVIDE([Total Debt PM], [Total Equity PM])
		formatString: 0.00
		displayFolder: Balance Sheet\Ratios
		lineageTag: 9ba33620-d70e-50e6-a1ec-2113913a6c52

	/// Equity as a share of total assets, comparison.
	measure 'Equity Ratio PM' = DIVIDE([Total Equity PM], [Total Assets PM])
		formatString: 0.0%
		displayFolder: Balance Sheet\Ratios
		lineageTag: 926df8ed-5104-56c3-a277-3695f417c681

	/// Assets minus liabilities minus equity. Zero when the statements tie.
	measure 'Balance Check' = [Total Assets AC] - [Total Liabilities AC] - [Total Equity AC]
		formatString: #,0
		displayFolder: Balance Sheet
		lineageTag: 172ac9f7-e165-59c7-b8c1-36fc0ce775f1

	/// Actual P&L amount for the twelve months ending at the as-of month.
	measure 'Amount LTM AC' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			VAR _ls = EDATE(_m, -11)
			RETURN CALCULATE([Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _ls && 'Calendar'[Date] <= _asof))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: d22f6f9b-6649-5890-946b-cf0402c9eff7

	/// Comparison P&L amount for the twelve months ending at the as-of month.
	measure 'Amount LTM PM' =
			VAR _asof = [As Of Date]
			VAR _m = DATE(YEAR(_asof), MONTH(_asof), 1)
			VAR _ls = EDATE(_m, -11)
			RETURN
			    SWITCH([Selected Comparison], "Prior Year", CALCULATE([Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= EDATE(_ls, -12) && 'Calendar'[Date] <= EDATE(_asof, -12))), "Forecast", CALCULATE([Forecast Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _ls && 'Calendar'[Date] <= _asof)), CALCULATE([Budget Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _ls && 'Calendar'[Date] <= _asof)))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: cad61a6c-23f6-515a-8e08-53ba2dbc154e

	/// Net Revenue, last twelve months, actual.
	measure 'Net Revenue LTM AC' = CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account Class] = "Revenue"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: af8c7b84-6366-5e06-832b-7b81587959b9

	/// Net Revenue, last twelve months, comparison.
	measure 'Net Revenue LTM PM' = CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account Class] = "Revenue"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: e667daeb-ef3c-5f9b-b621-d349eabf8472

	/// EBITDA, last twelve months, actual.
	measure 'EBITDA LTM AC' = CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: e1a24cbe-a560-540d-9221-abb4d4f7a058

	/// EBITDA, last twelve months, comparison.
	measure 'EBITDA LTM PM' = CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses"}))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: 9a92bc79-8d5e-5b85-9398-4453de5fb58c

	/// EBIT, last twelve months, actual.
	measure 'EBIT LTM AC' = CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: e18cf632-9189-5a51-b603-1fae2f20da0b

	/// EBIT, last twelve months, comparison.
	measure 'EBIT LTM PM' = CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account Class] IN {"Revenue", "Cost of Sales", "Operating Expenses", "Depreciation & Amortization"}))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: 8c731e6d-0e7c-5b47-b506-bfc35562ac7c

	/// Net Income, last twelve months, actual.
	measure 'Net Income LTM AC' = CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account Class] <> ""))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: 2c62515d-dd7f-5e1c-a6db-45315df280dd

	/// Net Income, last twelve months, comparison.
	measure 'Net Income LTM PM' = CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account Class] <> ""))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: 191cfe23-9ce3-589c-901d-3b39fa9da827

	/// COGS, last twelve months, actual (positive).
	measure 'COGS LTM AC' = -CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account Class] = "Cost of Sales"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: 712441da-7729-5948-9ecf-8cbaee77420a

	/// COGS, last twelve months, comparison (positive).
	measure 'COGS LTM PM' = -CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account Class] = "Cost of Sales"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: cd60cdda-c781-55af-b73f-82ae73949f33

	/// Interest Expense, last twelve months, actual (positive).
	measure 'Interest Expense LTM AC' = -CALCULATE([Amount LTM AC], KEEPFILTERS('Account'[Account] = "Interest Expense"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: c26c4ede-ccad-508b-a019-10af89131c3d

	/// Interest Expense, last twelve months, comparison (positive).
	measure 'Interest Expense LTM PM' = -CALCULATE([Amount LTM PM], KEEPFILTERS('Account'[Account] = "Interest Expense"))
		formatString: #,0
		displayFolder: P&L\LTM
		lineageTag: e376fd27-a59b-51b4-a3dd-8b979b7dcb18

	/// Days sales outstanding: receivables over LTM revenue x 365, actual.
	measure 'DSO AC' = DIVIDE([Receivables AC], [Net Revenue LTM AC]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 401c8df6-b76d-5da2-8402-fbb7bc04fb60

	/// Days inventory outstanding: inventory over LTM cost of sales x 365, actual.
	measure 'DIO AC' = DIVIDE([Inventory AC], [COGS LTM AC]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: f931690c-8916-52ae-956c-f03d5a724312

	/// Days payables outstanding: payables over LTM cost of sales x 365, actual.
	measure 'DPO AC' = DIVIDE([Payables AC], [COGS LTM AC]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 3798bddd-a3ee-5fa6-b2b8-e8f1ff43ebf6

	/// DSO + DIO - DPO in days, actual.
	measure 'Cash Conversion Cycle AC' = [DSO AC] + [DIO AC] - [DPO AC]
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 7bf3fd2a-d8de-5ebe-a948-69e02b31576d

	/// Return on equity: LTM net income over equity at period end, actual.
	measure 'ROE AC' = DIVIDE([Net Income LTM AC], [Total Equity AC])
		formatString: 0.0%
		displayFolder: Returns
		lineageTag: 57a876c2-8fb9-5b04-ae1e-f1a7cbcecf3a

	/// Leverage: net debt over LTM EBITDA, actual.
	measure 'Net Debt to EBITDA AC' = DIVIDE([Net Debt AC], [EBITDA LTM AC])
		formatString: 0.00
		displayFolder: Returns
		lineageTag: 5ee1136e-dd23-5d3a-9736-49df1028dd2f

	/// LTM EBIT over LTM interest expense, actual.
	measure 'Interest Coverage AC' = DIVIDE([EBIT LTM AC], [Interest Expense LTM AC])
		formatString: 0.00
		displayFolder: Returns
		lineageTag: 1a752692-a0ca-5faf-a187-f419ff1a61ca

	/// Days sales outstanding: receivables over LTM revenue x 365, comparison.
	measure 'DSO PM' = DIVIDE([Receivables PM], [Net Revenue LTM PM]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 7af7493a-25fc-5a1c-87a9-990bee9d3d0c

	/// Days inventory outstanding: inventory over LTM cost of sales x 365, comparison.
	measure 'DIO PM' = DIVIDE([Inventory PM], [COGS LTM PM]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 5c354166-b253-5fc0-97a6-2b5acb5f18a8

	/// Days payables outstanding: payables over LTM cost of sales x 365, comparison.
	measure 'DPO PM' = DIVIDE([Payables PM], [COGS LTM PM]) * 365
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 3bd73da4-914d-5c1f-b82f-c791338e97c4

	/// DSO + DIO - DPO in days, comparison.
	measure 'Cash Conversion Cycle PM' = [DSO PM] + [DIO PM] - [DPO PM]
		formatString: 0
		displayFolder: Working Capital
		lineageTag: 01be59f7-4b5e-52ed-84a1-2ff0a9e6d45d

	/// Return on equity: LTM net income over equity at period end, comparison.
	measure 'ROE PM' = DIVIDE([Net Income LTM PM], [Total Equity PM])
		formatString: 0.0%
		displayFolder: Returns
		lineageTag: 6940a866-26ce-5d05-a8e5-3bdfd141b662

	/// Leverage: net debt over LTM EBITDA, comparison.
	measure 'Net Debt to EBITDA PM' = DIVIDE([Net Debt PM], [EBITDA LTM PM])
		formatString: 0.00
		displayFolder: Returns
		lineageTag: 4ada3bb3-0831-53a8-9f7e-7aeebc1f666b

	/// LTM EBIT over LTM interest expense, comparison.
	measure 'Interest Coverage PM' = DIVIDE([EBIT LTM PM], [Interest Expense LTM PM])
		formatString: 0.00
		displayFolder: Returns
		lineageTag: c1740f1b-636f-550d-ac7f-885d3dae489e

	/// Actual cash flow in the current filter context, no time window.
	measure 'Cash Flow Actual Amount' = CALCULATE(SUM(FactCF[Amount]), FactCF[Scenario] = "Actual")
		formatString: #,0
		displayFolder: Cash Flow\Base
		lineageTag: dc36d0e0-f39f-5cbe-a335-17b9dd4011f6

	/// Budget cash flow in the current filter context, no time window.
	measure 'Cash Flow Budget Amount' = CALCULATE(SUM(FactCF[Amount]), FactCF[Scenario] = "Budget")
		formatString: #,0
		displayFolder: Cash Flow\Base
		lineageTag: 2ac300b4-bd27-5234-a66e-ccf4d31ed7f8

	/// Forecast cash flow in the current filter context, no time window.
	measure 'Cash Flow Forecast Amount' = CALCULATE(SUM(FactCF[Amount]), FactCF[Scenario] = "Forecast")
		formatString: #,0
		displayFolder: Cash Flow\Base
		lineageTag: 76a0aca7-848a-516a-beba-d2115789b223

	/// Actual cash flow for the reporting window.
	measure 'Cash Flow AC' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Cash Flow Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: 200a0fd9-6552-50e7-bb97-db73082402ce

	/// Budget cash flow for the reporting window.
	measure 'Cash Flow BU' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Cash Flow Budget Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: 8cb45b48-2c40-5bb7-95db-c0287e84c8b9

	/// Forecast cash flow for the reporting window.
	measure 'Cash Flow FC' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Cash Flow Forecast Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= _start && 'Calendar'[Date] <= _end))
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: 9a291278-7e8b-50f9-8ddb-a45946a5ba64

	/// Actual cash flow for the same window one year earlier.
	measure 'Cash Flow PY' =
			VAR _end = [As Of Date]
			VAR _start = [Period Start]
			RETURN CALCULATE([Cash Flow Actual Amount], FILTER(ALL('Calendar'), 'Calendar'[Date] >= EDATE(_start, -12) && 'Calendar'[Date] <= EDATE(_end, -12)))
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: c0b90e67-02b9-5814-9909-00a83995835e

	/// Comparison cash flow for the reporting window, following the Compare toggle.
	measure 'Cash Flow PM' = SWITCH([Selected Comparison], "Prior Year", [Cash Flow PY], "Forecast", [Cash Flow FC], [Cash Flow BU])
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: 454e9710-69e5-5726-ace8-55aed685653f

	/// Actual cash flow in the current month context.
	measure 'Cash Flow Monthly AC' = [Cash Flow Actual Amount]
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: 218583de-73bf-5beb-8e44-f0da7b88cf85

	/// Comparison cash flow in the current month context.
	measure 'Cash Flow Monthly PM' = SWITCH([Selected Comparison], "Prior Year", CALCULATE([Cash Flow Actual Amount], SAMEPERIODLASTYEAR('Calendar'[Date])), "Forecast", [Cash Flow Forecast Amount], [Cash Flow Budget Amount])
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: b5f55e5b-afaa-527f-937a-800780194271

	/// Operating Cash Flow for the reporting window, actual.
	measure 'Operating Cash Flow AC' = CALCULATE([Cash Flow AC], KEEPFILTERS('CFLine'[Activity] = "Operating"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 4bf00cc8-3c03-5c1b-9e2e-5b924e3dfeac

	/// Investing Cash Flow for the reporting window, actual.
	measure 'Investing Cash Flow AC' = CALCULATE([Cash Flow AC], KEEPFILTERS('CFLine'[Activity] = "Investing"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: af21d2c7-bc40-532a-bee2-2f423b7ddad1

	/// Financing Cash Flow for the reporting window, actual.
	measure 'Financing Cash Flow AC' = CALCULATE([Cash Flow AC], KEEPFILTERS('CFLine'[Activity] = "Financing"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 74fba683-0448-5bf2-9088-83ad08cf2788

	/// Free Cash Flow for the reporting window, actual.
	measure 'Free Cash Flow AC' = CALCULATE([Cash Flow AC], KEEPFILTERS('CFLine'[Activity] IN {"Operating", "Investing"}))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: e959501f-2a73-58f6-80ac-39fff94b7636

	/// Operating + investing + financing cash flow, actual.
	measure 'Net Change in Cash AC' = [Cash Flow AC]
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: b299e792-eac9-5609-91e0-b82551eeca85

	/// Capital expenditure incl. capitalized software (positive), actual.
	measure 'Capex AC' = -CALCULATE([Cash Flow AC], KEEPFILTERS('CFLine'[CF Metric] IN {"CAPEX", "CAPSW"}))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 8657bae6-e2df-5b2b-a2e5-7b517035fca8

	/// Operating cash flow over EBITDA, actual.
	measure 'Cash Conversion % AC' = DIVIDE([Operating Cash Flow AC], [EBITDA AC])
		formatString: 0.0%
		displayFolder: Cash Flow\Lines
		lineageTag: 81fcabcf-1c64-5352-98fa-4826206e9880

	/// Free cash flow in the current month context, actual.
	measure 'Free Cash Flow Monthly AC' = CALCULATE([Cash Flow Monthly AC], KEEPFILTERS('CFLine'[Activity] IN {"Operating", "Investing"}))
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: 0d52c33f-eb68-5717-aa80-0083dc46b834

	/// Operating cash flow in the current month context, actual.
	measure 'Operating Cash Flow Monthly AC' = CALCULATE([Cash Flow Monthly AC], KEEPFILTERS('CFLine'[Activity] = "Operating"))
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: 39674584-4453-571d-b46a-281609ba43ba

	/// Operating Cash Flow for the reporting window, comparison.
	measure 'Operating Cash Flow PM' = CALCULATE([Cash Flow PM], KEEPFILTERS('CFLine'[Activity] = "Operating"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: cf731690-adad-5f94-a279-98f12780eac5

	/// Investing Cash Flow for the reporting window, comparison.
	measure 'Investing Cash Flow PM' = CALCULATE([Cash Flow PM], KEEPFILTERS('CFLine'[Activity] = "Investing"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 629d9ac0-19cc-5ece-a06b-c4607a9b2a6c

	/// Financing Cash Flow for the reporting window, comparison.
	measure 'Financing Cash Flow PM' = CALCULATE([Cash Flow PM], KEEPFILTERS('CFLine'[Activity] = "Financing"))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 3d97a799-b2c2-56e1-8bc7-092a0a67b806

	/// Free Cash Flow for the reporting window, comparison.
	measure 'Free Cash Flow PM' = CALCULATE([Cash Flow PM], KEEPFILTERS('CFLine'[Activity] IN {"Operating", "Investing"}))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: 6227b117-e6b2-5653-ab17-441374887f21

	/// Operating + investing + financing cash flow, comparison.
	measure 'Net Change in Cash PM' = [Cash Flow PM]
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: e8e2e98f-dc9a-545c-ad92-2b5f8eef3253

	/// Capital expenditure incl. capitalized software (positive), comparison.
	measure 'Capex PM' = -CALCULATE([Cash Flow PM], KEEPFILTERS('CFLine'[CF Metric] IN {"CAPEX", "CAPSW"}))
		formatString: #,0
		displayFolder: Cash Flow\Lines
		lineageTag: e0d67b4b-1b76-593a-bbb9-c5588ac3f221

	/// Operating cash flow over EBITDA, comparison.
	measure 'Cash Conversion % PM' = DIVIDE([Operating Cash Flow PM], [EBITDA PM])
		formatString: 0.0%
		displayFolder: Cash Flow\Lines
		lineageTag: 8cb472ee-023c-5bc1-8dd5-f5e8c93dc10b

	/// Free cash flow in the current month context, comparison.
	measure 'Free Cash Flow Monthly PM' = CALCULATE([Cash Flow Monthly PM], KEEPFILTERS('CFLine'[Activity] IN {"Operating", "Investing"}))
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: 762d3449-ada0-52db-84f3-dca70d635c35

	/// Operating cash flow in the current month context, comparison.
	measure 'Operating Cash Flow Monthly PM' = CALCULATE([Cash Flow Monthly PM], KEEPFILTERS('CFLine'[Activity] = "Operating"))
		formatString: #,0
		displayFolder: Cash Flow\Monthly
		lineageTag: 1fdfcb69-f947-5f9c-a0da-8f56554c2a18

	/// Cash at the start of the reporting window (closing cash less the window's net cash flow).
	measure 'Opening Cash AC' = [Cash AC] - [Net Change in Cash AC]
		formatString: #,0
		displayFolder: Cash Flow
		lineageTag: c3b12eb0-538f-57ae-a3b9-a23cfac2bdf9

	/// Forecast net revenue in the current month context (segmented AC + FC chart).
	measure 'Net Revenue Monthly FC' = CALCULATE([Forecast Amount], KEEPFILTERS('Account'[Account Class] = "Revenue"))
		formatString: #,0
		displayFolder: IBCS Visuals
		lineageTag: bab41491-93e0-545d-abf9-423205df5b3d

	/// Scenario code FC, for visuals that take the comparison label from a measure.
	measure 'Scenario FC' = "FC"
		displayFolder: IBCS Visuals
		lineageTag: 4f4636a5-1712-5f9d-8304-b5afd97bb230

	/// Actual gross margin in the current month context (combo chart line).
	measure 'Gross Margin % Monthly AC' = DIVIDE([Gross Profit Monthly AC], [Net Revenue Monthly AC])
		formatString: 0.0%
		displayFolder: IBCS Visuals
		lineageTag: 98ebbba6-f89d-5d31-a00a-10ade3a18dd3

	/// Operating expenses as a positive amount, prior year, for the reporting window.
	measure 'OPEX PY' = -[Operating Expenses PY]
		formatString: #,0
		displayFolder: IBCS Visuals
		lineageTag: 808948fa-7820-5316-bf65-11655502f8d3

	/// P&L amount for a whole year: actual for closed years, the full-year forecast for the current year.
	measure 'Tree Amount' =
			VAR _y = MAX('Calendar'[Year])
			VAR _fc = _y >= YEAR([Last Closed Date])
			RETURN IF(_fc, [Forecast Amount], [Actual Amount])
		formatString: #,0
		displayFolder: IBCS Visuals\Tree
		lineageTag: 5c07834a-ea1d-5ed5-b752-6c57bed7b245

	/// Net income for the year (all P&L accounts), actual or full-year forecast.
	measure 'Tree Net Income' = [Tree Amount]
		formatString: #,0
		displayFolder: IBCS Visuals\Tree
		lineageTag: bb8e9468-0fea-5616-8648-b62c2b36c4ff

	/// Net revenue for the year, actual or full-year forecast.
	measure 'Tree Net Revenue' = CALCULATE([Tree Amount], KEEPFILTERS('Account'[Account Class] = "Revenue"))
		formatString: #,0
		displayFolder: IBCS Visuals\Tree
		lineageTag: 987e3259-4558-5f63-a567-7fee3f4dea7c

	/// Total assets at year end (December), actual or forecast.
	measure 'Tree Assets' =
			VAR _y = MAX('Calendar'[Year])
			VAR _fc = _y >= YEAR([Last Closed Date])
			VAR _scn = IF(_fc, "Forecast", "Actual")
			RETURN CALCULATE(SUM(FactBS[Balance]), FactBS[Scenario] = _scn, 'BSAccount'[BS Level 1] = "Assets", FILTER(ALL('Calendar'), 'Calendar'[Date] = DATE(_y, 12, 1)))
		formatString: #,0
		displayFolder: IBCS Visuals\Tree
		lineageTag: b0e72bb5-54c7-5552-a16f-7687d42f8f5a

	/// Net income over net revenue for the year.
	measure 'Tree Return on Sales' = DIVIDE([Tree Net Income], [Tree Net Revenue])
		formatString: 0.0%
		displayFolder: IBCS Visuals\Tree
		lineageTag: 833fc23b-8904-5e08-b516-d2fe7807bb65

	/// Net revenue over year-end total assets.
	measure 'Tree Asset Turnover' = DIVIDE([Tree Net Revenue], [Tree Assets])
		formatString: 0.00
		displayFolder: IBCS Visuals\Tree
