		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: d8160c80-9921-5f88-adcd-4ea8d1af8f66

	/// Cash at the end of the as-of month, actual.
	measure 'Cash AC' = CALCULATE([Balance AC], KEEPFILTERS('BSAccount'[BS Metric] = "CASH"))
		formatString: #,0
		displayFolder: Balance Sheet\Lines
		lineageTag: c1e20a01-598b-541d-b384-7c0131c787c0

	/// Cash at the end of the as-of month, comparison.
	measure 'Cash PM' = CALCULATE([Balance PM], KEEPFILTERS('BSAccount'[BS Metric] = "CASH"))
