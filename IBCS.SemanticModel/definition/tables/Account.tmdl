		summarizeBy: none
		sourceColumn: Expense Category

	partition Account = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimAccount.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"AccountKey", Int64.Type}, {"Account", type text}, {"Statement Line", type text}, {"Line Order", Int64.Type}, {"Account Order", Int64.Type}, {"Account Class", type text}, {"Class Order", Int64.Type}, {"Class Short", type text}, {"Line Short", type text}, {"Expense Category", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

